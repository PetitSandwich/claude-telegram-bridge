[Unit]
Description=Telegram <-> Claude Code bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user and paths to your setup
User=root
WorkingDirectory=/opt/claude-bridge
# Make the `claude` CLI and its login session reachable from systemd's minimal env.
# Adjust /root if the service runs as a different User.
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Load secrets/config from an env file (copy from .env.example)
EnvironmentFile=/opt/claude-bridge/.env
ExecStart=/opt/claude-bridge/venv/bin/python /opt/claude-bridge/bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
