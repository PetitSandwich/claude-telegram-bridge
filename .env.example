# ── Required ──────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather (or write it to ~/.claude-bridge/telegram-token)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# LEAVE THIS UNSET AND ANYONE CAN RUN A CODING AGENT ON THIS MACHINE.
ALLOWED_USERS=123456789

# ── Claude Code auth ────────────────────────────────────────────────────────
# If Claude Code is already logged in on this machine (`claude login`), you can
# leave this empty and the bridge uses that session.
# Required only when CLAUDE_BARE=1.
ANTHROPIC_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Directory Claude Code reads/writes/runs in. Use a dedicated folder.
CLAUDE_WORKSPACE=/opt/claude-bridge/workspace

# Default model: opus | sonnet | haiku | or a full model string
CLAUDE_MODEL=sonnet

# Permission posture: acceptEdits | dontAsk | bypassPermissions | plan | default
CLAUDE_PERMISSION_MODE=acceptEdits

# Extra tools to pre-approve (comma/space separated), e.g. "Bash,Read,Edit"
CLAUDE_ALLOWED_TOOLS=

# Bare mode: skip CLAUDE.md / MCP / hooks / skills. Requires ANTHROPIC_API_KEY.
CLAUDE_BARE=

# Per-turn timeout in seconds
CLAUDE_TIMEOUT=600

# Where the bridge stores its token + settings
BRIDGE_CONFIG_DIR=
